# SECURITY: Placeholder values only. Never commit real credentials.
# Generate a proxy token with:
# python3 -c "import secrets; print(secrets.token_urlsafe(40))"

SQLWATCHER_DATABASE_URL=postgresql://sqlwatcher:REPLACE_WITH_NEON_PASSWORD@YOUR_NEON_HOST/sqlwatcher?sslmode=require
TARGET_DATABASE_URL=postgresql://secureshop:REPLACE_WITH_NEON_PASSWORD@YOUR_NEON_HOST/secureshop?sslmode=require
DIRECT_DATABASE_URL=postgresql://secureshop:REPLACE_WITH_NEON_PASSWORD@YOUR_NEON_HOST/secureshop?sslmode=require
SQLWATCHER_PROXY_DATABASE_URL=postgresql://secureshop:REPLACE_WITH_NEON_PASSWORD@YOUR_FLY_PROXY_HOST.fly.dev:15432/secureshop?sslmode=disable
SQLWATCHER_PROXY_TOKEN=REPLACE_WITH_STRONG_RANDOM_SECRET

ENVIRONMENT=production
LOG_FORMAT=json
SESSION_TTL_HOURS=8
REALTIME_SYNC_MIN_INTERVAL_SECONDS=2
REALTIME_SYNC_BATCH_SIZE=75
FRONTEND_ORIGINS=https://your-sqlwatcher-frontend.vercel.app,https://your-secureshop-frontend.vercel.app
CORS_ORIGINS=https://your-secureshop-frontend.vercel.app

SQLWATCHER_API_BASE=https://your-sqlwatcher-backend.onrender.com/api
SQLWATCHER_BACKEND_URL=https://your-sqlwatcher-backend.onrender.com
SQLWATCHER_USERNAME=admin
SQLWATCHER_PASSWORD=REPLACE_WITH_PRODUCTION_PASSWORD
DEFAULT_CONNECTION_MODE=proxy

# Production DB pool sizing. Adjust down for strict free-tier limits, up for paid Neon/Render.
CONTROL_DB_POOL_MIN_SIZE=3
CONTROL_DB_POOL_MAX_SIZE=20
TARGET_DB_POOL_MIN_SIZE=3
TARGET_DB_POOL_MAX_SIZE=20
DB_POOL_MAX_INACTIVE_CONNECTION_LIFETIME=300
